{
  "name": "sloponator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "docs": "tsx scripts/gen-docs.mjs",
    "check": "npm run typecheck && npm test && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.48.2",
    "@types/node": "18.19.130",
    "eslint": "9.39.5",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.72.0",
    "vitest": "2.1.9"
  },
  "overrides": {
    "ndarray-pixels": "5.0.1"
  }
}
